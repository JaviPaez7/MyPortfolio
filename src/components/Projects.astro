---
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import Supabase from "./icons/Supabase.astro"
import ReactIcon from "./icons/React.astro"
import AstroIcon from "./icons/AstroIcon.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"
import Stripe from "./icons/Stripe.astro"

const pill = "bg-white/5 text-white/90 border border-white/10"

const TAGS = {
  NEXT: { name: "Next.js", class: pill, icon: NextJS },
  REACT: { name: "React", class: pill, icon: ReactIcon },
  TAILWIND: { name: "Tailwind CSS", class: pill, icon: Tailwind },
  SUPABASE: { name: "Supabase", class: pill, icon: Supabase },
  ASTRO: { name: "Astro", class: pill, icon: AstroIcon },
  POSTGRES: { name: "PostgreSQL", class: pill, icon: PostgreSQL },
  STRIPE: { name: "Stripe", class: pill, icon: Stripe },
}

const PROJECTS = [
  {
    title: "Tanke — gasolina barata en Canarias y península",
    description:
      "Comparador de precios en tiempo real: filtro por provincia, municipio y tipo de combustible, más modo cerca de mí. Lo uso yo; lo saqué a producción en tanke.javistudio.dev.",
    link: "https://tanke.javistudio.dev/",
    github: "https://github.com/JaviPaez7/tanke",
    image: "/projects/tanke.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.POSTGRES],
  },
  {
    title: "Dancefloor — landing y entradas con Stripe",
    description:
      "Web del evento DanceFloor: line-up, aforo y checkout de entradas con Stripe. Next.js en producción en dancefloor.javistudio.dev.",
    link: "https://dancefloor.javistudio.dev/",
    image: "/projects/dancefloor.webp",
    tags: [TAGS.NEXT, TAGS.STRIPE, TAGS.TAILWIND],
  },
  {
    title: "Connecticat — red social para gatos",
    description:
      "Catstagram, Gatinder, curiosidades y foro. Astro + React en el front, PostgreSQL detrás. Producto completo, no un landing.",
    link: "https://connecticat.javistudio.dev/",
    github: "https://github.com/JaviPaez7/connecticat",
    image: "/projects/connecticat.webp",
    tags: [TAGS.ASTRO, TAGS.REACT, TAGS.POSTGRES],
  },
  {
    title: "Dumelis — calendario de turnos compartido",
    description:
      "Pintas tus turnos, invitas al grupo y ves de un vistazo los días libres en común. Tiempo real, pensado para gente que rota turnos de verdad.",
    link: "https://dumelis.javistudio.dev/",
    image: "/projects/dumelis.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    title: "DM Command — panel para Dungeon Masters",
    description:
      "Combat tracker, bestiario, dados, soundboard y notas de campaña. PWA con backend propio; sirve para dirigir mesa sin diez pestañas abiertas.",
    link: "https://dm-dashboard.javistudio.dev/",
    github: "https://github.com/JaviPaez7/dm-dashboard",
    image: "/projects/dm-command.webp",
    tags: [TAGS.REACT, TAGS.TAILWIND],
  },
  {
    title: "Pokewordle — adivina el Pokémon del día",
    description:
      "Wordle con atributos (tipo, hábitat, altura…). Modo diario, práctica, silueta y más. Un reto nuevo cada 24 horas.",
    link: "https://pokewordle.javistudio.dev/",
    github: "https://github.com/JaviPaez7/pokeWordle",
    image: "/projects/pokewordle.webp",
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TAILWIND],
  },
  {
    title: "Moviefy — explorador de cine y series",
    description:
      "Catálogo con TMDB, scroll infinito y favoritos persistentes. Para descubrir estrenos sin pelearte con la API a pelo.",
    link: "https://moviefy.javistudio.dev/",
    github: "https://github.com/JaviPaez7/Moviefy",
    image: "/projects/moviefy.webp",
    tags: [TAGS.REACT, TAGS.TAILWIND],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:ring-1 lg:ring-white/10 lg:hover:ring-white/20 ">
      <a href={link} target="_blank" rel="noopener noreferrer" class="w-full h-full">
        <img alt={`Captura de ${title}`} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" width="1200" height="750" src={image} />
      </a>
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="text-2xl font-bold text-gray-100 mb-2">
      <a href={link} target="_blank" rel="noopener noreferrer" class="hover:text-yellow-200 transition-colors">
        {title}
      </a>
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row flex-wrap mb-2 gap-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-2 text-gray-400 text-pretty">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <a
              href={github}
              role="link"
              class="inline-flex items-center justify-center gap-2 px-3 py-2 space-x-2 text-base text-white transition bg-gray-800 border border-gray-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400/60 rounded-xl active:bg-gray-700 hover:bg-gray-700 hover:border-gray-500 group max-w-fit"
            >
              <GitHub class="size-6" />
              Código
            </a>
          )}
          {link && link !== "#" && (
            <a
              href={link}
              role="link"
              class="inline-flex items-center justify-center gap-2 px-3 py-2 space-x-2 text-base text-white transition bg-gray-800 border border-gray-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400/60 rounded-xl active:bg-gray-700 hover:bg-gray-700 hover:border-gray-500 group max-w-fit"
            >
              <Link class="size-4" />
              Demo
            </a>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }

  <p class="text-center text-gray-400 text-sm">
    Hay más en el hub:{" "}
    <a
      href="https://javistudio.dev/proyectos/"
      class="text-yellow-200 hover:underline"
      rel="noopener"
      >javistudio.dev/proyectos</a
    >.
  </p>
</div>
