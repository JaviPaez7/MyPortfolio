---
const EDUCATION = [
  {
    date: "2026 — Actualidad",
    title: "Máster DWA · Desarrollo Web Avanzado Full Stack",
    school: "Nett Digital School",
    description:
      "Formación avanzada en desarrollo de productos web, arquitectura Full Stack y herramientas actuales. Programa en curso, combinado con prácticas profesionales en IAbot.",
    current: true,
  },
  {
    date: "Enero — Junio 2024",
    title: "Bootcamp Full Stack Web Development · 800+ horas",
    school: "Reboot Academy",
    description:
      "Formación intensiva con honores en PostgreSQL, Express, React y Node.js, diseño de bases de datos y metodologías ágiles.",
  },
  {
    date: "2015 — 2017",
    title: "Técnico Superior en Actividad Física y Animación Deportiva",
    school: "I.E.S. Nueva Isleta Tony Gallardo",
    description:
      "Formación superior orientada a planificación, comunicación, trabajo en equipo y dirección de actividades.",
  },
]
---

<div class="grid gap-4 md:grid-cols-2">
  {
    EDUCATION.map((item, index) => (
      <article class={`rounded-2xl border border-white/10 bg-white/[0.03] p-6 ${index === 0 ? "md:col-span-2 ring-1 ring-yellow-400/20" : ""}`}>
        <div class="mb-3 flex flex-wrap items-center gap-3 text-sm text-gray-400">
          <time>{item.date}</time>
          {item.current && (
            <span class="rounded-full border border-yellow-400/30 bg-yellow-400/10 px-2.5 py-1 text-xs font-semibold text-yellow-200">
              En curso
            </span>
          )}
        </div>
        <h3 class="text-xl font-bold text-white">{item.title}</h3>
        <p class="mt-1 font-medium text-yellow-300">{item.school}</p>
        <p class="mt-3 text-sm leading-relaxed text-gray-400">{item.description}</p>
      </article>
    ))
  }
</div>
