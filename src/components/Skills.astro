---
import BrandIcon from "./icons/BrandIcon.astro"

const pill = "bg-white/5 text-white/90 border border-white/10"

const SKILLS = [
  {
    name: "Next.js",
    class: pill,
    icon: "nextdotjs",
  },
  {
    name: "React",
    class: pill,
    icon: "react",
  },
  {
    name: "Tailwind CSS",
    class: pill,
    icon: "tailwindcss",
  },
  {
    name: "Astro",
    class: pill,
    icon: "astro",
  },
  {
    name: "Node.js",
    class: pill,
    icon: "nodedotjs",
  },
  {
    name: "Docker",
    class: pill,
    icon: "docker",
  },
  {
    name: "PostgreSQL",
    class: pill,
    icon: "postgresql",
  },
  {
    name: "Git",
    class: pill,
    icon: "git",
  },
]
---

<div class="flex flex-wrap gap-3 mt-8">
  {
    SKILLS.map((skill) => (
      <span
        class={`flex items-center gap-x-2 rounded-full text-xs ${skill.class} py-2 px-4 hover:bg-white/10 hover:scale-105 transition-all cursor-default`}
      >
        <BrandIcon name={skill.icon} class="size-4 shrink-0" />
        {skill.name}
      </span>
    ))
  }
</div>
