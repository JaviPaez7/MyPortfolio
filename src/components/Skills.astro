---
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Supabase from "./icons/Supabase.astro"
import ReactIcon from "./icons/React.astro"
import NodeIcon from "./icons/Node.astro"
import AstroIcon from "./icons/AstroIcon.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"
import GitIcon from "./icons/Git.astro"

const SKILLS = [
  { name: "Next.js", icon: NextJS },
  { name: "React", icon: ReactIcon },
  { name: "Tailwind CSS", icon: Tailwind },
  { name: "Astro", icon: AstroIcon },
  { name: "Node.js", icon: NodeIcon },
  { name: "Supabase", icon: Supabase },
  { name: "PostgreSQL", icon: PostgreSQL },
  { name: "Git", icon: GitIcon },
]
---

<div class="flex flex-wrap gap-3 mt-8">
  {
    SKILLS.map((skill) => (
      <span class="flex items-center gap-x-2 rounded-full text-xs text-white/90 bg-white/5 border border-white/10 py-2 px-4 hover:bg-white/10 hover:scale-105 transition-all cursor-default">
        <skill.icon class="size-4 shrink-0" />
        {skill.name}
      </span>
    ))
  }
</div>
